{
  "name": "@molio2-editor/app",
  "productName": "Spec Editor Community",
  "version": "1.0.1",
  "private": true,
  "description": "Electron desktop app for viewing and editing Molio 2.0 files.",
  "author": {
    "name": "3D Byggeri",
    "email": "thv@3dbyggeri.dk"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/check-native-abi.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "ensure-electron": "node scripts/ensure-electron.cjs",
    "rebuild-native": "npm run ensure-electron && electron-rebuild -f -w better-sqlite3 --module-dir ../.. && node scripts/sign-native-modules.cjs",
    "postinstall": "npm run ensure-electron && electron-rebuild -f -w better-sqlite3 --module-dir ../.. && node scripts/sign-native-modules.cjs || echo 'postinstall had issues; run `npm run rebuild-native` manually'",
    "package": "npm run build && node scripts/run-electron-builder.cjs",
    "package:mac": "npm run build && node scripts/run-electron-builder.cjs --mac",
    "package:win": "npm run build && node scripts/run-electron-builder.cjs --win",
    "package:linux": "npm run build && node scripts/run-electron-builder.cjs --linux",
    "package:dir": "npm run build && node scripts/run-electron-builder.cjs --dir",
    "verify:mac-signing": "node scripts/verify-mac-signing.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@fontsource/open-sans": "^5.2.7",
    "@molio2-editor/core": "*",
    "@tiptap/core": "^3.22.4",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-table": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "better-sqlite3": "^12.10.0",
    "dompurify": "^3.4.0",
    "electron-updater": "^6.6.2",
    "fflate": "^0.8.2",
    "html-to-pdfmake": "^2.5.11",
    "lucide-react": "^1.8.0",
    "pdfmake": "^0.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.7.0",
    "@types/pdfmake": "^0.2.9",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.6.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  }
}
