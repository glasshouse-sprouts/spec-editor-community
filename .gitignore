node_modules/
dist/
out/
*.tsbuildinfo
coverage/
.DS_Store
tmp/
*.log
.vscode/
.idea/
# Python bytecode cache. `scripts/generate-test-fixtures.py` is the only
# Python in the repo, but running it (or linting it) drops a __pycache__
# next to it, and the Community export copies whatever is committed.
__pycache__/
*.py[cod]

# Generated MCP deploy tree (≈142 MB: bundled Node binary + node_modules).
# Regenerated by `npm run deploy`. MUST stay out of git.
packages/mcp-server/deploy/
# Cached Node tarballs used by prepare-deploy.cjs.
packages/mcp-server/scripts/.node-cache/
# Cached/transpiled config files (electron-vite / vitest write these).
*.config.*.mjs

# Stray TypeScript emit artifacts next to .ts/.tsx sources.
# These appear when someone runs `tsc -b` (composite project emit).
# Vite's runtime resolver can serve these instead of transforming .tsx,
# which causes the UI to show a stale pre-edit version of the app.
packages/app/src/**/*.js
packages/app/src/**/*.js.map
packages/app/src/**/*.d.ts
packages/app/src/**/*.d.ts.map
# But keep the hand-written ambient type files:
!packages/app/src/shared/global.d.ts
!packages/app/src/preload/global.d.ts

# Hand-written ambient module declarations live in a `types/` folder
# (these are NOT tsc emit, which lands next to its .ts source). Keep tracked.
!packages/app/src/**/types/**/*.d.ts
